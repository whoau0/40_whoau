# Supabase 연결 정보 (지점 매출 & 리뷰 분석 공용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 공공데이터포털 공휴일(특일) 정보 API 키 (지점 매출)
HOLIDAY_API_KEY=your-holiday-api-key

# 공공데이터포털 소비자위해정보 위해정보접수 API 키 (리뷰 분석)
CONSUMER_SAFETY_API_KEY=your-consumer-safety-api-key

# Google Gemini API Key (리뷰 분석)
GEMINI_API_KEY=your-gemini-api-key

# (선택) 지점 매출 대시보드 보안 토큰
DASHBOARD_ACCESS_SECRET=brew-boss-secret-key-2026
